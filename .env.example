# Production site URL, for example: https://your-domain.com
NEXT_PUBLIC_SITE_URL=

# Server-only AI assistant configuration. Without a configured provider, the assistant
# uses its restricted local site-knowledge guidance and never sends a model request.
# Set AI_PROVIDER to openai, anthropic, gemini, or local. A local provider must expose an
# OpenAI-compatible /chat/completions endpoint through AI_BASE_URL.
AI_PROVIDER=openai
AI_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
AI_BASE_URL=
AI_API_KEY=

# Optional future embedding provider configuration. The first AI SaaS release
# keeps pgvector storage ready and falls back to tenant-scoped lexical retrieval
# until a dedicated embedding worker/provider is configured.
AI_EMBEDDING_MODEL=
AI_EMBEDDING_API_KEY=

# AI Business Copilot reuses the server-only model configuration above. Manage
# model priority and daily/monthly Token limits in /admin/ai/settings; never put
# an API key in the database or in a NEXT_PUBLIC_ variable.

# Server-only transactional email and CRM automation configuration. Set a verified
# Resend sender in CRM_EMAIL_FROM before enabling mail delivery rules.
RESEND_API_KEY=
CRM_EMAIL_FROM=
CONTACT_EMAIL=
CRM_SECRET=

# CMS server-only configuration. Create the initial admin by using either a bcrypt
# ADMIN_PASSWORD_HASH or a temporary ADMIN_PASSWORD during `pnpm prisma:seed`.
DATABASE_URL=
AUTH_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
ADMIN_PASSWORD=
NEXTAUTH_URL=http://localhost:3000

# Server-only Stripe billing configuration. Checkout and verified webhooks remain
# unavailable until both values are configured in the deployment environment.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Vercel Blob media storage and SaaS private delivery files. The client portal
# writes organization-scoped private paths; never expose this token to the browser.
# STORAGE_URL is reserved for a future alternative object-storage provider and does
# not replace BLOB_READ_WRITE_TOKEN.
BLOB_READ_WRITE_TOKEN=
STORAGE_URL=

# Enterprise API Gateway. The current single-instance fallback uses a fixed window;
# production multi-instance deployments should use Redis for distributed limiting.
ENTERPRISE_GATEWAY_RATE_LIMIT=60
ENTERPRISE_GATEWAY_RATE_WINDOW_MS=60000
ENTERPRISE_GATEWAY_CONCURRENCY_LIMIT=4
REDIS_URL=

# Enterprise SSO. Store the actual client secret/certificate only in the deployment
# secret store. SSOConnection saves an environment-variable reference, never its value.
# Example reference: ENTERPRISE_SSO_CLIENT_SECRET
ENTERPRISE_SSO_CLIENT_SECRET=
ENTERPRISE_SAML_SIGNING_CERTIFICATE=

# Observability. Both Sentry DSNs are optional: without one, the site still runs
# and /admin/system reports monitoring as not configured. Keep SENTRY_AUTH_TOKEN
# server-only; use it only in CI/Vercel to upload source maps during production builds.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
