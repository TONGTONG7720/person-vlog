generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ProjectStatus {
  COMPLETED
  IN_PROGRESS
  CONCEPT
}

enum MessageStatus {
  UNREAD
  PROCESSING
  COMPLETED
  ARCHIVED
}

enum KnowledgeSyncStatus {
  CURRENT
  PENDING
}

enum LeadStatus {
  NEW
  CONTACTED
  DISCOVERY
  PROPOSAL
  NEGOTIATION
  WON
  LOST
}

enum LeadPriority {
  LOW
  MEDIUM
  HIGH
}

enum LeadActivityType {
  NOTE
  EMAIL
  CALL
  MEETING
  STATUS_CHANGE
}

enum CrmTaskStatus {
  TODO
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum CrmProjectStatus {
  PLANNING
  DESIGN
  DEVELOPMENT
  TESTING
  DEPLOY
  COMPLETED
}

enum ProposalStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
}

enum AutomationRuleTrigger {
  LEAD_CREATED
}

enum AutomationRuleAction {
  CREATE_FOLLOW_UP_TASK
  SEND_CONTACT_CONFIRMATION
  SEND_ADMIN_NOTIFICATION
}

enum AiAgentType {
  LEAD
  PROPOSAL
  CONTENT
  KNOWLEDGE
  PROJECT
  MEETING
}

enum AiUsageStatus {
  COMPLETED
  FAILED
  SKIPPED
}

enum AiContentDraftStatus {
  DRAFT
  REVIEWED
  ARCHIVED
}

enum AiProjectPlanStatus {
  DRAFT
  APPROVED
  ARCHIVED
}

enum NotificationChannelType {
  EMAIL
  WECHAT
  TELEGRAM
}

enum SaasRoleKey {
  OWNER
  ADMIN
  ENTERPRISE_OWNER
  SECURITY_ADMIN
  DEPARTMENT_ADMIN
  MEMBER
  VIEWER
}

enum MembershipStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

enum EnterpriseStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum EnterpriseSsoProvider {
  SAML
  OIDC
  OAUTH2
}

enum AiDocumentStatus {
  UPLOADING
  PROCESSING
  SECURITY_REVIEW
  READY
  FAILED
}

enum AiDocumentSourceType {
  TEXT
  MARKDOWN
  PDF
  DOCX
}

enum AiDocumentJobStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
}

enum AiUsageChannel {
  DASHBOARD
  API
  APP
}

enum AiOperatingAgentRole {
  PLANNER
  RESEARCH
  DATA
  WRITER
  ACTION
}

enum AiAgentMemoryType {
  SHORT_TERM
  LONG_TERM
}

enum AiWorkflowRunStatus {
  QUEUED
  RUNNING
  AWAITING_APPROVAL
  APPROVED
  COMPLETED
  FAILED
}

enum AiEmployeeStatus {
  ACTIVE
  PAUSED
  ARCHIVED
}

enum AiToolRiskLevel {
  READ
  WRITE
  HIGH
}

enum AiApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  EXECUTED
  EXPIRED
}

enum AiTraceEventType {
  TASK_QUEUED
  AGENT_STARTED
  AGENT_COMPLETED
  TOOL_CALLED
  APPROVAL_REQUIRED
  APPROVAL_RESOLVED
  TASK_COMPLETED
  TASK_FAILED
}

enum AiAppType {
  KNOWLEDGE
  CUSTOMER
  SALES
  DATA
  WORKFLOW
}

enum AiAppStatus {
  DRAFT
  TESTING
  PUBLISHED
  ARCHIVED
}

enum AiAppEnvironment {
  DEVELOPMENT
  PRODUCTION
}

enum AiAppAccessRuleKind {
  ALL_MEMBERS
  ROLE
  DEPARTMENT
  MEMBERSHIP
}

enum WorkspaceProjectStatus {
  PLANNING
  DESIGN
  DEVELOPMENT
  TESTING
  DEPLOY
  COMPLETED
}

enum ProjectTaskStatus {
  TODO
  DOING
  REVIEW
  DONE
}

enum ProjectTaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ProjectActivityType {
  PROJECT_CREATED
  TASK_CREATED
  TASK_UPDATED
  DOCUMENT_CREATED
  FILE_UPLOADED
}

enum ProjectDocumentKind {
  FILE
  MARKDOWN
}

enum ProjectFileStorageProvider {
  VERCEL_BLOB
  S3
  CLOUDFLARE_R2
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

enum InvoiceStatus {
  DRAFT
  OPEN
  PAID
  VOID
  UNCOLLECTIBLE
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum BillingCycle {
  MONTHLY
  YEARLY
}

enum OrganizationLifecycleStage {
  LEAD
  TRIAL
  CUSTOMER
  INACTIVE
}

enum UserNotificationKind {
  PROJECT_UPDATED
  TASK_ASSIGNED
  AI_READY
  BILLING_UPDATED
  TRIAL_ENDING
  SUBSCRIPTION_CANCELLED
  ENTERPRISE_MEMBER_JOINED
  ENTERPRISE_ROLE_CHANGED
  ENTERPRISE_SECURITY_EVENT
}

enum MarketplaceItemType {
  AGENT
  WORKFLOW
  PROMPT
  TEMPLATE
  PLUGIN
}

enum MarketplaceItemStatus {
  DRAFT
  REVIEW
  PUBLISHED
  REJECTED
  ARCHIVED
}

enum MarketplaceReviewStatus {
  PENDING
  VISIBLE
  HIDDEN
}

enum MarketplaceRevenueType {
  SALE
  PLATFORM_FEE
  REFUND
  PAYOUT
}

enum MarketplaceApiUsageStatus {
  COMPLETED
  REJECTED
  FAILED
}

model User {
  id            String          @id @default(cuid())
  email         String          @unique
  passwordHash  String?
  createdAt     DateTime        @default(now())
  activities    AdminActivity[]
  memberships   Membership[]
  notifications Notification[]
  auditLogs     AuditLog[]
  marketplaceCreator       MarketplaceCreator?
  marketplaceReviews       MarketplaceReview[]
  marketplaceFavorites     MarketplaceFavorite[]
  reviewedMarketplaceItems MarketplaceItem[]        @relation("MarketplaceItemReviewer")
  marketplaceItemVersions  MarketplaceItemVersion[] @relation("MarketplaceItemVersionCreator")
}

model Enterprise {
  id                       String                    @id @default(cuid())
  name                     String
  domain                   String?
  logo                     String?
  status                   EnterpriseStatus          @default(ACTIVE)
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  organizations            Organization[]
  departments              Department[]
  memberships              Membership[]
  workspaces               Workspace[]
  projects                 WorkspaceProject[]
  tasks                    ProjectTask[]
  activities               ProjectActivity[]
  documents                ProjectDocument[]
  knowledge                WorkspaceKnowledgeDocument[]
  embeddings               WorkspaceKnowledgeEmbedding[]
  aiWorkspaces             AiWorkspace[]
  aiAssistants             AiAssistant[]
  aiDocuments              AiKnowledgeDocument[]
  aiVectors                AiVectorDocument[]
  aiDocumentJobs           AiDocumentJob[]
  aiApiKeys                AiApiKey[]
  aiAssistantUsageLogs     AiAssistantUsageLog[]
  aiAgents                 AiAgent[]
  aiAgentMemories          AiAgentMemory[]
  aiKnowledgeEntities      AiKnowledgeEntity[]
  aiKnowledgeRelations     AiKnowledgeRelation[]
  aiWorkflows              AiWorkflow[]
  aiEmployees              AiEmployee[]
  aiTools                  AiTool[]
  aiTaskRuns               AiTaskRun[]
  aiApprovalRequests       AiApprovalRequest[]
  aiTaskTraces             AiTaskTrace[]
  aiReports                AiReport[]
  aiGovernancePolicies     AiGovernancePolicy[]
  aiApps                   AiApp[]
  auditLogs                AuditLog[]
  domains                  EnterpriseDomain[]
  ssoConnections           SSOConnection[]
  securityPolicy           EnterpriseSecurityPolicy?
  resourcePermissionGrants ResourcePermissionGrant[]

  @@index([status, createdAt])
}

model Department {
  id             String       @id @default(cuid())
  enterpriseId   String
  organizationId String
  name           String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  enterprise     Enterprise   @relation(fields: [enterpriseId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberships    Membership[]
  workspaces     Workspace[]

  @@unique([organizationId, name])
  @@index([enterpriseId, createdAt])
}

model EnterpriseDomain {
  id                String     @id @default(cuid())
  enterpriseId      String
  domain            String     @unique
  verificationToken String
  verifiedAt        DateTime?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  enterprise        Enterprise @relation(fields: [enterpriseId], references: [id], onDelete: Cascade)

  @@index([enterpriseId, verifiedAt])
}

model SSOConnection {
  id              String                @id @default(cuid())
  enterpriseId    String
  provider        EnterpriseSsoProvider
  metadata        Json
  secretReference String?
  enabled         Boolean               @default(false)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  enterprise      Enterprise            @relation(fields: [enterpriseId], references: [id], onDelete: Cascade)

  @@index([enterpriseId, enabled, createdAt])
}

model EnterpriseSecurityPolicy {
  id                    String     @id @default(cuid())
  enterpriseId          String     @unique
  requireSso            Boolean    @default(false)
  requireMfa            Boolean    @default(false)
  allowPersonalApiKeys  Boolean    @default(false)
  sensitiveDataScanning Boolean    @default(true)
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt
  enterprise            Enterprise @relation(fields: [enterpriseId], references: [id], onDelete: Cascade)
}

model Project {
  id           String        @id @default(cuid())
  title        String
  slug         String
  locale       String        @default("zh-CN")
  translationGroup String?
  description  String
  content      String?
  categories   String[]
  technologies String[]
  coverImage   String?
  status       ProjectStatus @default(CONCEPT)
  featured     Boolean       @default(false)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([updatedAt])
  @@index([translationGroup, locale])
  @@unique([locale, slug])
}

model Post {
  id              String   @id @default(cuid())
  title           String
  slug            String
  locale          String   @default("zh-CN")
  translationGroup String?
  description     String
  content         String
  tags            String[]
  keywords        String[] @default([])
  category        String
  coverImage      String?
  ogImage         String?
  seoTitle        String?
  seoDescription  String?
  canonical       String?
  relatedPosts    String[] @default([])
  relatedProjects String[] @default([])
  relatedServices String[] @default([])
  socialContent   Json?
  published       Boolean  @default(false)
  publishedAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([published, publishedAt])
  @@index([category, published])
  @@index([translationGroup, locale])
  @@unique([locale, slug])
}

model ContentPlan {
  id          String   @id @default(cuid())
  title       String
  locale      String   @default("zh-CN")
  keyword     String
  category    String
  status      String   @default("idea")
  priority    String   @default("normal")
  publishDate DateTime?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status, publishDate])
  @@index([category, priority])
  @@index([locale, status])
}

model Keyword {
  id          String   @id @default(cuid())
  keyword     String   @unique
  category    String
  difficulty  String?
  volume      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category, updatedAt])
}

model Newsletter {
  id        String   @id @default(cuid())
  email     String   @unique
  status    String   @default("pending")
  source    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
}

model Service {
  id          String   @id @default(cuid())
  title       String
  slug        String
  locale      String   @default("zh-CN")
  translationGroup String?
  description String
  category    String
  content     String?
  featured    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@index([translationGroup, locale])
  @@unique([locale, slug])
}

model Message {
  id        String        @id @default(cuid())
  name      String
  email     String
  company   String?
  service   String
  budget    String?
  timeline  String?
  message   String
  status    MessageStatus @default(UNREAD)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  lead      Lead?         @relation("ContactMessageLead")

  @@index([status, createdAt])
}

model Lead {
  id                  String       @id @default(cuid())
  name                String
  email               String
  company             String?
  source              String?
  service             String?
  budget              String?
  timeline            String?
  notes               String?
  status              LeadStatus   @default(NEW)
  priority            LeadPriority @default(MEDIUM)
  score               Int          @default(0)
  tags                String[]     @default([])
  messageId           String?      @unique
  followUpScheduledAt DateTime?
  aiSummary           String?
  aiCategory          String?
  aiDifficulty        String?
  aiSuggestedService  String?
  aiQuestions         String[]     @default([])
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  message             Message?     @relation("ContactMessageLead", fields: [messageId], references: [id], onDelete: SetNull)
  activities          LeadActivity[]
  tasks               CrmTask[]
  projects            CrmProject[]
  proposals           Proposal[]
  meetings            MeetingNote[]

  @@index([status, updatedAt])
  @@index([source, createdAt])
  @@index([email])
}

model LeadActivity {
  id        String           @id @default(cuid())
  leadId    String
  type      LeadActivityType
  content   String
  createdAt DateTime         @default(now())
  lead      Lead             @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId, createdAt])
}

model CrmTask {
  id        String        @id @default(cuid())
  title     String
  leadId    String?
  projectId String?
  status    CrmTaskStatus @default(TODO)
  dueDate   DateTime?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  lead      Lead?         @relation(fields: [leadId], references: [id], onDelete: SetNull)
  project   CrmProject?   @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([status, dueDate])
  @@index([leadId, createdAt])
  @@index([projectId, createdAt])
}

model CrmProject {
  id               String            @id @default(cuid())
  leadId           String?
  title            String
  description      String?
  status           CrmProjectStatus  @default(PLANNING)
  startedAt        DateTime?
  dueDate          DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  lead             Lead?             @relation(fields: [leadId], references: [id], onDelete: SetNull)
  tasks            CrmTask[]
  aiPlans          AiProjectPlan[]
  workspaceProject WorkspaceProject?

  @@index([status, updatedAt])
  @@index([leadId])
}

model Proposal {
  id        String         @id @default(cuid())
  leadId    String
  title     String
  content   String
  status    ProposalStatus @default(DRAFT)
  aiGenerated Boolean       @default(false)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  lead      Lead           @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId, updatedAt])
  @@index([status, updatedAt])
}

model AutomationRule {
  id         String                @id @default(cuid())
  name       String                @unique
  trigger    AutomationRuleTrigger
  action     AutomationRuleAction
  delayHours Int                   @default(0)
  enabled    Boolean               @default(true)
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt

  @@index([trigger, enabled])
}

model Knowledge {
  id                 String              @id @default(cuid())
  title              String
  slug               String              @unique
  content            String
  category           String
  source             String?
  aiGenerated        Boolean             @default(false)
  enabled            Boolean             @default(true)
  syncStatus         KnowledgeSyncStatus @default(PENDING)
  embeddingUpdatedAt DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([enabled, category])
}

model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MediaAsset {
  id          String   @id @default(cuid())
  pathname    String   @unique
  url         String
  contentType String
  size        Int
  createdAt   DateTime @default(now())
}

model AdminActivity {
  id         String   @id @default(cuid())
  action     String
  resource   String
  resourceId String?
  summary    String
  createdAt  DateTime @default(now())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
}

model AnalyticsEvent {
  id        String   @id @default(cuid())
  event     String
  path      String
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([event, createdAt])
  @@index([path, createdAt])
}

model MeetingNote {
  id        String   @id @default(cuid())
  leadId    String?
  content   String
  summary   String
  createdAt DateTime @default(now())
  lead      Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@index([leadId, createdAt])
}

model AiContentDraft {
  id                   String               @id @default(cuid())
  topic                String
  title                String
  outline              String[]             @default([])
  seoDescription       String
  xiaohongshuDirection String
  videoScript          String
  status               AiContentDraftStatus @default(DRAFT)
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  @@index([status, updatedAt])
}

model AiProjectPlan {
  id        String              @id @default(cuid())
  projectId String
  summary   String
  tasks     String[]            @default([])
  status    AiProjectPlanStatus @default(DRAFT)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  project   CrmProject          @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, updatedAt])
  @@index([status, updatedAt])
}

model AiModelConfig {
  id           String       @id @default(cuid())
  provider     String
  model        String
  enabled      Boolean      @default(true)
  priority     Int          @default(100)
  maxTokens    Int          @default(1200)
  dailyLimit   Int?
  monthlyLimit Int?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  usageLogs    AiUsageLog[]

  @@unique([provider, model])
  @@index([enabled, priority])
}

model AiUsageLog {
  id            String        @id @default(cuid())
  agent         AiAgentType
  status        AiUsageStatus
  provider      String
  model         String
  inputTokens   Int           @default(0)
  outputTokens  Int           @default(0)
  costMicros    Int           @default(0)
  modelConfigId String?
  createdAt     DateTime      @default(now())
  modelConfig   AiModelConfig? @relation(fields: [modelConfigId], references: [id], onDelete: SetNull)

  @@index([agent, createdAt])
  @@index([status, createdAt])
  @@index([modelConfigId, createdAt])
}

model Prompt {
  id        String   @id @default(cuid())
  name      String
  content   String
  version   Int
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, version])
  @@index([name, enabled, version])
}

model NotificationChannel {
  id        String                  @id @default(cuid())
  type      NotificationChannelType @unique
  enabled   Boolean                 @default(false)
  createdAt DateTime                @default(now())
  updatedAt DateTime                @updatedAt
}

model Organization {
  id             String                     @id @default(cuid())
  enterpriseId   String
  name           String
  slug           String                     @unique
  logo           String?
  lifecycleStage OrganizationLifecycleStage @default(LEAD)
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt
  enterprise     Enterprise                 @relation(fields: [enterpriseId], references: [id], onDelete: Cascade)
  departments    Department[]
  memberships    Membership[]
  workspaces     Workspace[]
  projects       WorkspaceProject[]
  tasks          ProjectTask[]
  activities     ProjectActivity[]
  documents      ProjectDocument[]
  knowledge      WorkspaceKnowledgeDocument[]
  embeddings     WorkspaceKnowledgeEmbedding[]
  auditLogs      AuditLog[]
  billingEvents  BillingEvent[]
  payments       Payment[]
  subscription   Subscription?
  usages         Usage[]
  aiWorkspaces   AiWorkspace[]
  aiAssistants   AiAssistant[]
  aiDocuments    AiKnowledgeDocument[]
  aiVectors      AiVectorDocument[]
  aiDocumentJobs AiDocumentJob[]
  aiApiKeys      AiApiKey[]
  aiAssistantUsageLogs AiAssistantUsageLog[]
  aiAgents                AiAgent[]
  aiAgentMemories         AiAgentMemory[]
  aiKnowledgeEntities     AiKnowledgeEntity[]
  aiKnowledgeRelations    AiKnowledgeRelation[]
  aiWorkflows             AiWorkflow[]
  aiEmployees             AiEmployee[]
  aiTools                 AiTool[]
  aiTaskRuns              AiTaskRun[]
  aiApprovalRequests      AiApprovalRequest[]
  aiTaskTraces            AiTaskTrace[]
  aiReports               AiReport[]
  aiGovernancePolicies    AiGovernancePolicy[]
  aiApps                  AiApp[]
  marketplaceItems     MarketplaceItem[]
  marketplaceApiUsages MarketplaceApiUsage[]
  resourcePermissionGrants ResourcePermissionGrant[]

  @@index([enterpriseId, createdAt])
  @@index([createdAt])
}

model Role {
  id          String           @id @default(cuid())
  key         SaasRoleKey      @unique
  name        String
  description String
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  memberships Membership[]
  permissions RolePermission[]
}

model Permission {
  id          String           @id @default(cuid())
  key         String           @unique
  name        String
  resource    String
  action      String
  description String
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  roles       RolePermission[]
  resourcePermissionGrants ResourcePermissionGrant[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model Membership {
  id                String          @id @default(cuid())
  userId            String
  enterpriseId      String
  organizationId    String
  departmentId      String
  roleId            String
  status            MembershipStatus @default(ACTIVE)
  joinedAt          DateTime        @default(now())
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  enterprise        Enterprise      @relation(fields: [enterpriseId], references: [id], onDelete: Cascade)
  organization      Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  department        Department      @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  role              Role            @relation(fields: [roleId], references: [id], onDelete: Restrict)
  assignedTasks     ProjectTask[]   @relation("ProjectTaskAssignee")
  projectActivities ProjectActivity[] @relation("ProjectActivityActor")
  uploadedDocuments ProjectDocument[] @relation("ProjectDocumentUploader")
  ownedProjects     WorkspaceProject[] @relation("WorkspaceProjectOwner")
  createdAiApiKeys  AiApiKey[]         @relation("AiApiKeyCreator")
  uploadedAiDocuments AiKnowledgeDocument[] @relation("AiKnowledgeDocumentUploader")
  resourcePermissionGrants ResourcePermissionGrant[] @relation("ResourcePermissionGrantee")
  createdResourcePermissionGrants ResourcePermissionGrant[] @relation("ResourcePermissionGrantCreator")
  requestedAiTaskRuns              AiTaskRun[] @relation("AiTaskRunRequester")
  reviewedAiApprovalRequests       AiApprovalRequest[] @relation("AiApprovalReviewer")
  aiAssistantUsageLogs             AiAssistantUsageLog[] @relation("AiAssistantUsageActor")

  @@unique([userId, organizationId])
  @@index([enterpriseId, organizationId, status])
  @@index([departmentId, createdAt])
  @@index([organizationId, createdAt])
  @@index([roleId])
}

model Workspace {
  id             String             @id @default(cuid())
  enterpriseId   String
  organizationId String
  departmentId   String
  name           String
  slug           String
  description    String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  enterprise     Enterprise         @relation(fields: [enterpriseId], references: [id], onDelete: Cascade)
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  department     Department         @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  projects       WorkspaceProject[]
  tasks          ProjectTask[]
  documents      ProjectDocument[]
  knowledge      WorkspaceKnowledgeDocument[]

