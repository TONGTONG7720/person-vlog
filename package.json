    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.182.0",
    "esbuild": "0.28.1",
    "eslint": "^9.39.1",
    "eslint-config-next": "^16.2.11",
    "husky": "9.1.7",
    "lint-staged": "17.2.0",
    "postcss": "^8.5.21",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "prisma": "^7.9.0",
