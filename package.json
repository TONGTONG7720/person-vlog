    "@react-three/fiber": "^9.6.1",
    "@sentry/nextjs": "10.68.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/blob": "^2.6.1",
    "@vercel/speed-insights": "2.0.0",
    "@xyflow/react": "^12.11.2",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "framer-motion": "^12.42.2",
    "fuse.js": "^7.5.0",
    "gsap": "^3.15.0",
    "lenis": "^1.3.25",
    "lucide-react": "^1.27.0",
    "mammoth": "^1.12.0",
    "next": "^16.2.11",
    "next-auth": "^4.24.15",
    "next-intl": "^4.13.4",
    "pdf-parse": "^2.4.5",
    "pg": "^8.22.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-email": "^6.9.1",
    "react-hook-form": "^7.82.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "resend": "^6.18.0",
    "stripe": "^22.3.2",
    "tailwind-merge": "^3.6.0",
    "three": "^0.182.0",
    "zod": "^4.4.3"
