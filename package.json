{
  "name": "tong-developer-brand",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=20.9.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:seed": "prisma db seed",
    "enterprise:worker": "node scripts/enterprise-worker.mjs",
    "start": "next start",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:ci": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit --incremental false",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{css,js,json,md,mjs,ts,tsx,yml,yaml}": "prettier --write"
  },
  "dependencies": {
