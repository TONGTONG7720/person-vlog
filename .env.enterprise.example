POSTGRES_DB=tong
POSTGRES_USER=tong
POSTGRES_PASSWORD=replace-with-a-long-random-password
REDIS_PASSWORD=replace-with-a-long-random-password
WEB_PORT=3000
DATABASE_URL=postgresql://tong:replace-with-a-long-random-password@postgres:5432/tong
NEXT_PUBLIC_SITE_URL=https://your-enterprise-domain.example
AUTH_SECRET=replace-with-a-long-random-secret
ADMIN_EMAIL=admin@your-enterprise-domain.example
ADMIN_PASSWORD_HASH=
REDIS_URL=redis://:replace-with-a-long-random-password@redis:6379
ENTERPRISE_GATEWAY_RATE_LIMIT=60
ENTERPRISE_GATEWAY_RATE_WINDOW_MS=60000
ENTERPRISE_GATEWAY_CONCURRENCY_LIMIT=4
