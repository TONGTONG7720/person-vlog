  workspace               AiWorkspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  taskRun                 AiTaskRun        @relation(fields: [taskRunId], references: [id], onDelete: Cascade)
  reviewedBy              Membership?      @relation("AiApprovalReviewer", fields: [reviewedByMembershipId], references: [id], onDelete: SetNull)

  @@index([enterpriseId, organizationId, workspaceId, status, requestedAt])
  @@index([taskRunId, status])
}

model AiTaskTrace {
  id             String           @id @default(cuid())
  enterpriseId   String
  organizationId String
  workspaceId    String
  taskRunId      String
  agentId        String?
  event          AiTraceEventType
  toolKey        String?
  payload        Json?
  createdAt      DateTime         @default(now())
  enterprise     Enterprise       @relation(fields: [enterpriseId], references: [id], onDelete: Cascade)
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace      AiWorkspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  taskRun        AiTaskRun        @relation(fields: [taskRunId], references: [id], onDelete: Cascade)
  agent          AiAgent?         @relation(fields: [agentId], references: [id], onDelete: SetNull)

  @@index([enterpriseId, organizationId, workspaceId, createdAt])
  @@index([taskRunId, createdAt])
}

model AiReport {
  id             String       @id @default(cuid())
  enterpriseId   String
  organizationId String
  workspaceId    String
  taskRunId      String?
  title          String
  content        String
  format         String       @default("MARKDOWN")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  enterprise     Enterprise   @relation(fields: [enterpriseId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace      AiWorkspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  taskRun        AiTaskRun?   @relation(fields: [taskRunId], references: [id], onDelete: SetNull)

  @@index([enterpriseId, organizationId, workspaceId, createdAt])
  @@index([taskRunId, createdAt])
}

model AiGovernancePolicy {
  id                 String       @id @default(cuid())
  enterpriseId       String
  organizationId     String
  allowedModels      String[]     @default([])
  enabledAgentRoles  String[]     @default([])
  enabledToolKeys    String[]     @default([])
  requireHumanApproval Boolean    @default(true)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  enterprise         Enterprise   @relation(fields: [enterpriseId], references: [id], onDelete: Cascade)
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId])
  @@index([enterpriseId, organizationId])
}

model MarketplaceCreator {
  id          String            @id @default(cuid())
  userId      String            @unique
  displayName String
  bio         String?
  avatarUrl   String?
  verified    Boolean           @default(false)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  items       MarketplaceItem[]
  revenues    MarketplaceRevenue[]

  @@index([verified, createdAt])
}

model MarketplaceItem {
  id               String                @id @default(cuid())
  organizationId   String
  creatorId        String
  type             MarketplaceItemType
  slug             String                @unique
  title            String
  description      String
  category         String
  tags             String[]              @default([])
  priceCents       Int?
  currency         String                @default("CNY")
  status           MarketplaceItemStatus @default(DRAFT)
  enabled          Boolean               @default(true)
  manifest         Json
  reviewReason     String?
  publishedAt      DateTime?
  reviewedAt       DateTime?
  reviewedByUserId String?
  usageCount       Int                   @default(0)
  favoriteCount    Int                   @default(0)
  ratingTotal      Int                   @default(0)
  ratingCount      Int                   @default(0)
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  organization     Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  creator          MarketplaceCreator    @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  reviewedBy       User?                 @relation("MarketplaceItemReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  versions         MarketplaceItemVersion[]
  reviews          MarketplaceReview[]
  favorites        MarketplaceFavorite[]
  plugin           MarketplacePlugin?
  revenues         MarketplaceRevenue[]
  apiUsages        MarketplaceApiUsage[]

  @@index([status, publishedAt])
  @@index([creatorId, status, createdAt])
  @@index([organizationId, status, createdAt])
  @@index([category, status, publishedAt])
}

model MarketplaceItemVersion {
  id              String          @id @default(cuid())
  itemId          String
  createdByUserId String?
  version         String
  content         Json
  changelog       String?
  artifactUrl     String?
  artifactHash    String?
  createdAt       DateTime        @default(now())
  item            MarketplaceItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  createdBy       User?           @relation("MarketplaceItemVersionCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@unique([itemId, version])
  @@index([itemId, createdAt])
}

model MarketplaceReview {
  id        String                  @id @default(cuid())
  itemId    String
  userId    String
  rating    Int
  content   String?
  status    MarketplaceReviewStatus @default(PENDING)
  createdAt DateTime                @default(now())
  updatedAt DateTime                @updatedAt
  item      MarketplaceItem         @relation(fields: [itemId], references: [id], onDelete: Cascade)
  user      User                    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([itemId, userId])
  @@index([itemId, status, createdAt])
  @@index([userId, createdAt])
}

model MarketplaceFavorite {
  itemId    String          
  userId    String
  createdAt DateTime        @default(now())
  item      MarketplaceItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([itemId, userId])
  @@index([userId, createdAt])
}

model MarketplacePlugin {
  id                 String          @id @default(cuid())
  itemId             String          @unique
  type               String
  config             Json
  permissions        String[]        @default([])
  enabled            Boolean         @default(false)
  rateLimitPerMinute Int             @default(20)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  item               MarketplaceItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([enabled, createdAt])
}

model MarketplaceRevenue {
  id              String                 @id @default(cuid())
  creatorId       String
  itemId          String?
  amountCents     Int
  currency        String                 @default("CNY")
  type            MarketplaceRevenueType
  providerReference String?               @unique
  availableAt     DateTime?
  createdAt       DateTime               @default(now())
  creator         MarketplaceCreator     @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  item            MarketplaceItem?      @relation(fields: [itemId], references: [id], onDelete: SetNull)

  @@index([creatorId, createdAt])
  @@index([itemId, createdAt])
}

model MarketplaceApiUsage {
  id             String                    @id @default(cuid())
  organizationId String
  itemId         String
  apiKeyId       String?
  status         MarketplaceApiUsageStatus
  inputTokens    Int                       @default(0)
  outputTokens   Int                       @default(0)
  createdAt      DateTime                  @default(now())
  organization   Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  item           MarketplaceItem           @relation(fields: [itemId], references: [id], onDelete: Cascade)
  apiKey         AiApiKey?                 @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([itemId, createdAt])
  @@index([apiKeyId, createdAt])
}

model Plan {
  id           String          @id @default(cuid())
  key          String          @unique
  slug         String          @unique
  name         String
  description  String
  priceCents   Int
  currency     String          @default("CNY")
  billingCycle BillingCycle    @default(MONTHLY)
  features     Json
  limits       Json
  active       Boolean         @default(true)
  trialDays    Int             @default(7)
  sortOrder    Int             @default(0)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  subscriptions Subscription[]
}

model Subscription {
  id                     String             @id @default(cuid())
  organizationId         String             @unique
  planId                 String
  status                 SubscriptionStatus @default(TRIALING)
  provider               String?
  providerCustomerId     String?
  providerSubscriptionId String?            @unique
  currentPeriodStartsAt  DateTime?
  currentPeriodEndsAt    DateTime?
  trialEndsAt            DateTime?
  cancelAtPeriodEnd      Boolean            @default(false)
  cancelledAt            DateTime?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  organization           Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan                   Plan               @relation(fields: [planId], references: [id], onDelete: Restrict)
  invoices               Invoice[]
  payments               Payment[]

  @@index([planId, status])
}

model Invoice {
  id             String        @id @default(cuid())
  subscriptionId String
  status         InvoiceStatus @default(DRAFT)
  amountCents    Int
  currency       String        @default("USD")
  providerId     String?       @unique
  issuedAt       DateTime?
  dueAt          DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  subscription   Subscription  @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId, createdAt])
}

model Payment {
  id             String        @id @default(cuid())
  organizationId String
  subscriptionId String
  status         PaymentStatus @default(PENDING)
  amountCents    Int
  currency       String        @default("CNY")
  provider       String?
  providerId     String?       @unique
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subscription   Subscription  @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([subscriptionId, createdAt])
}

model Usage {
  id             String       @id @default(cuid())
  organizationId String
  feature        String
  count          Int          @default(0)
  period         String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, feature, period])
  @@index([organizationId, period])
}

model BillingEvent {
  id              String        @id @default(cuid())
  organizationId  String?
  provider        String
  providerEventId String        @unique
  type            String
  payload         Json
  processedAt     DateTime      @default(now())
  createdAt       DateTime      @default(now())
  organization    Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([provider, type, createdAt])
}

model Notification {
  id        String               @id @default(cuid())
  userId    String
  kind      UserNotificationKind
  title     String
  content   String
  read      Boolean              @default(false)
  createdAt DateTime             @default(now())
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read, createdAt])
}

model AuditLog {
  id             String       @id @default(cuid())
  enterpriseId   String
  organizationId String
  userId         String?
  action         String
  resource       String
  resourceId     String?
  metadata       Json?
  ipHash         String?
  createdAt      DateTime     @default(now())
  enterprise     Enterprise   @relation(fields: [enterpriseId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([enterpriseId, organizationId, createdAt])
  @@index([organizationId, createdAt])
  @@index([userId, createdAt])
}

model ResourcePermissionGrant {
  id                    String       @id @default(cuid())
  enterpriseId          String
  organizationId        String
  membershipId          String
  permissionId          String
  resourceType          String
  resourceId            String
  createdByMembershipId String?
  expiresAt             DateTime?
  createdAt             DateTime     @default(now())
  enterprise            Enterprise   @relation(fields: [enterpriseId], references: [id], onDelete: Cascade)
  organization          Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  membership            Membership   @relation("ResourcePermissionGrantee", fields: [membershipId], references: [id], onDelete: Cascade)
  permission            Permission   @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdBy             Membership?  @relation("ResourcePermissionGrantCreator", fields: [createdByMembershipId], references: [id], onDelete: SetNull)

  @@unique([membershipId, permissionId, resourceType, resourceId])
  @@index([enterpriseId, organizationId, resourceType, resourceId])
  @@index([membershipId, expiresAt])
}
